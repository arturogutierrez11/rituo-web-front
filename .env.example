RITUO_API_URL=https://api.rituo.io
NEXT_PUBLIC_API_URL=https://api.rituo.io
RITUO_INTERNAL_API_KEY=replace-with-internal-api-key

# Gate de /rituo-admin/*: login real contra auth.api (tabla admin_users) +
# cookie de sesión propia firmada con esta clave. Generar con:
# openssl rand -base64 48
RITUO_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Backend de identidad/usuarios (auth.api). Usado por /rituo-admin/login y
# por la verificación de email / reset de contraseña de la app.
RITUO_AUTH_API_URL=https://auth.rituo.io

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Rituo <hola@rituo.io>"
# Opcional: copia interna al equipo. Dejar vacío para enviar solo al email del form.
RESEND_WAITLIST_NOTIFY_TO=
# Destinatario del formulario de contacto. Si se omite, usa hello@rituo.io.
RESEND_CONTACT_TO=hello@rituo.io

# Backend de catálogo/órdenes/pagos (checkout.api). El token de Mercado Pago y
# el envío de emails de compra viven ahí, no acá.
RITUO_CHECKOUT_API_URL=http://localhost:3001
RITUO_CHECKOUT_INTERNAL_API_KEY=replace-with-the-same-key-as-checkout-api

# Pixel ID / Dataset ID de Meta (no es secreto, se expone en el navegador).
NEXT_PUBLIC_META_PIXEL_ID=1422490586402788
